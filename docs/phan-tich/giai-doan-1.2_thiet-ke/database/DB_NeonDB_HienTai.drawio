55;" vertex="1" parent="c26"><mxGeometry x="180" y="168" width="120" height="20" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;FK&lt;/b&gt;&amp;nbsp;voucher_id" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;overflow=hidden;" vertex="1" parent="c26"><mxGeometry y="188" width="190" height="20" as="geometry"/></mxCell><mxCell id="c44" value="bigint NN" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;spacingRight=6;fontSize=10;fontColor=#555555;" vertex="1" parent="c26"><mxGeometry x="180" y="188" width="120" height="20" as="geometry"/></mxCell><mxCell id="c49" value="Voucher (2 bảng)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="34" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Quy tắc giữ lượt&lt;/b&gt;&lt;br&gt;1. vouchers = loại voucher; quantity = số lượt được dùng tối đa, valid_days = hạn mặc định khi phát.&lt;br&gt;2. Phát voucher tạo 1 dòng voucher_details (mã riêng, issued_at, expires_at) và giữ 1 lượt.&lt;br&gt;3. Khách dùng: status = USED, ghi order_id, chiếm luôn lượt. Huỷ đơn: về lại ISSUED.&lt;br&gt;4. Hết hạn hoặc thu hồi (EXPIRED / REVOKED): trả lượt.&lt;br&gt;5. Còn lại = quantity − (đang giữ + đã dùng); hết lượt thì không phát thêm." style="rounded=1;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;whiteSpace=wrap;fillColor=#fff8ee;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="500" y="354" width="670" height="140" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;Chú thích&lt;/b&gt;&lt;br&gt;PK: khoá chính (gạch chân) · FK: khoá ngoại · UQ: duy nhất · NN: NOT NULL&lt;br&gt;Crow's foot: | = một, &amp;lt; = nhiều, o = không bắt buộc · Bảng nét đứt: thuộc nhóm khác (chỉ hiện id)&lt;br&gt;Ẩn 6 cột kiểm vết: created_by, created_at, updated_by, updated_at, del_flag, del_user · Đọc từ Neon ngày 23/10/2026" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="524" width="1100" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1398902889" name="Khuyến mãi &amp; gợi ý bán"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c176" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#555555;" edge="1" parent="1" source="c29" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c177" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#555555;" edge="1" parent="1" source="c31" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c178" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#555555;" edge="1" parent="1" source="c46" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c179" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#555555;" edge="1" parent="1" source="c61" target="c42"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c180" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#555555;" edge="1" parent="1" source="c63" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c181" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startS