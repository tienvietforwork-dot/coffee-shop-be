<mxfile host="drawio"><diagram name="Sơ đồ kiến trúc hệ thống" id="ARCH01_KienTrucHeThong"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="790" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Sơ đồ kiến trúc hệ thống – Website bán cà phê Coffeeholic" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Người dùng" style="rounded=1;arcSize=3;html=1;dashed=1;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="220" height="560" as="geometry"/></mxCell><mxCell id="c4" value="Khách hàng&#xa;(quét QR / website)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=13;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="110" y="100" width="40" height="70" as="geometry"/></mxCell><mxCell id="c5" value="Nhân viên" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="110" y="280" width="40" height="70" as="geometry"/></mxCell><mxCell id="c6" value="Quản lý" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="110" y="450" width="40" height="70" as="geometry"/></mxCell><mxCell id="c7" value="Tầng giao diện (Frontend)" style="rounded=1;arcSize=3;html=1;dashed=1;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="290" y="50" width="300" height="560" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;coffee-shop-fe&lt;/b&gt;&lt;br&gt;React 18 + TypeScript + Vite&lt;br&gt;Ant Design · React Query · Zustand&lt;br&gt;Axios (REST) · STOMP/SockJS (thời gian thực)&lt;br&gt;&lt;br&gt;&lt;i&gt;Trang khách hàng&lt;/i&gt; (quét QR tại bàn / online): thực đơn, giỏ hàng, đặt hàng, voucher, theo dõi đơn, phản hồi&lt;br&gt;&lt;i&gt;Trang quản trị:&lt;/i&gt; order tại quầy, đơn hàng, pha chế &amp;amp; phục vụ, kho, CRM, đợt giảm giá &amp;amp; voucher, phân tích&lt;br&gt;&lt;br&gt;Đóng gói Docker + Nginx" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="140" width="260" height="380" as="geometry"/></mxCell><mxCell id="c9" value="API Gateway" style="rounded=1;arcSize=3;html=1;dashed=1;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="640" y="50" width="280" height="560" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;nginx-gateway&lt;/b&gt; (Render)&lt;br&gt;Cổng vào duy nhất của frontend&lt;br&gt;&lt;br&gt;/api/crm/* → app-crm&lt;br&gt;/api/promotions/* → app-promotions&lt;br&gt;/api/stats/* → app-stats&lt;br&gt;/ws (WebSocket) → app-core&lt;br&gt;/api/* còn lại → app-core" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="190" width="240" height="280" as="geometry"/></mxCell><mxCell id="c11" value="Tầng dịch vụ (Backend) – Spring Boot 3.3 · Java 17 · Docker trên Render" style="rounded=1;arcSize=3;html=1;dashed=1;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="970" y="50" width="470" height="560" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;app-crm&lt;/b&gt; – Quản lý quan hệ khách hàng&lt;br&gt;Hồ sơ khách hàng, tương tác &amp;amp; chăm sóc, phản hồi, phân nhóm, hành vi, phân tích khách hàng" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="990" y="90" width="430" height="90" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;app-stats&lt;/b&gt; – Thống kê&lt;br&gt;Báo cáo doanh thu, phân tích khách hàng và hiệu quả giảm giá (truy vấn trực tiếp đơn hàng, thanh toán)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="990" y="195" width="430" height="90" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;app-promotions&lt;/b&gt; – Khuyến mãi&lt;br&gt;Đợt giảm giá (cho hóa đơn / cà phê cụ thể), voucher (khách hàng sở hữu), phân tích hiệu quả giảm giá" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="990" y="300" width="430" height="90" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;app-core&lt;/b&gt; – Sales &amp;amp; Operation&lt;br&gt;Cà phê &amp;amp; thực đơn, giỏ hàng, đặt hàng &amp;amp; thanh toán, đơn hàng, vận hành pha chế &amp;amp; giao nhận, kho nguyên liệu&lt;br&gt;WebSocket STOMP (thông báo đơn hàng, tồn kho) · Scheduler (cảnh báo tồn kho)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="990" y="405" width="430" height="160" as="geometry"/></mxCell><mxCell id="c16" value="Tầng dữ liệu" style="rounded=1;arcSize=3;html=1;dashed=1;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1490" y="50" width="250" height="560" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;PostgreSQL (Neon)&lt;/b&gt;&lt;br&gt;CSDL dùng chung&lt;br&gt;cho 4 dịch vụ" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1530" y="240" width="170" height="160" as="geometry"/></mxCell><mxCell id="c18" value="JDBC / JPA" style="text;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1440" y="300" width="60" height="20" as="geometry"/></mxCell><mxCell id="c19" value="Dịch vụ bên ngoài (dự kiến tích hợp)" style="rounded=1;arcSize=3;html=1;dashed=1;fillColor=#fafafa;strokeColor=#999999;verticalAlign=bottom;fontStyle=1;fontSize=13;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="970" y="640" width="470" height="110" as="geometry"/></mxCell><mxCell id="c20" value="Cổng thanh toán trực tuyến" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=middle;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="990" y="660" width="200" height="50" as="geometry"/></mxCell><mxCell id="c21" value="Đối tác giao hàng (đặt xe / tài xế)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=middle;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="1220" y="660" width="200" height="50" as="geometry"/></mxCell><mxCell id="c22" value="Triển khai &amp;amp; vận hành (DevOps)" style="rounded=1;arcSize=3;html=1;dashed=1;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="900" height="110" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;GitHub&lt;/b&gt; – monorepo coffee-shop-be + coffee-shop-fe" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="260" height="50" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;GitHub Actions&lt;/b&gt; – CI riêng cho từng app (lọc theo thư mục)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="680" width="270" height="50" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Sao lưu CSDL&lt;/b&gt; – pg_dump PostgreSQL (Neon) hằng tuần bằng GitHub Actions" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="630" y="680" width="270" height="50" as="geometry"/></mxCell><mxCell id="c26" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge