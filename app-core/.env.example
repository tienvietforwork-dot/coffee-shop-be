# Copy to .env for local (non-docker-compose) use, or set these as environment
# variables / secrets in your deployment platform (Render, etc).

# --- Database (PostgreSQL) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/coffeeshop
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# --- JWT ---
# Use a long, random string in production (>= 32 bytes).
JWT_SECRET=change-this-super-secret-key-in-production-please-0123456789
JWT_EXPIRATION_MS=86400000

# --- CORS ---
# The origin of your deployed frontend, e.g. https://coffee-shop-fe.vercel.app
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- Server ---
# Render provides PORT automatically; SERVER_PORT is used as a fallback for
# other environments / local runs.
PORT=8080
SERVER_PORT=8080
