# API Gateway — single public entrypoint fanning out to the 4 independent
# backend apps in this monorepo. The frontend only ever talks to THIS
# gateway; it never needs to know the other 4 apps' real URLs.
#
# Routing rules:
#   /api/crm/*         -> app-crm        (rewritten to /api/* for that app)
#   /api/stats/*        -> app-stats      (rewritten to /api/* for that app)
#   /api/promotions/*  -> app-promotions (rewritten to /api/* for that app)
#   /ws                -> app-core        (WebSocket, unchanged)
#   everything else    -> app-core        (its existing /api/auth, /api/products,
#                                           /api/materials, /api/orders, ... paths
#                                           are passed through unchanged)
#
# CORE_UPSTREAM / CRM_UPSTREAM / STATS_UPSTREAM / PROMOTIONS_UPSTREAM must be
# BARE HOSTNAMES (no "https://", no trailing slash), e.g.
#   CORE_UPSTREAM=coffee-shop-be-gn7a.onrender.com
# Render's edge is shared across many customers' apps behind the same IPs,
# so it relies on both the TLS SNI and the HTTP Host header to route to the
# right one — proxy_ssl_server_name + proxy_set_header Host below make sure
# both carry the real upstream hostname instead of the gateway's own.

resolver 8.8.8.8 ipv6=off;

server {
    listen ${PORT};

    location /api/crm/ {
        set $upstream_host ${CRM_UPSTREAM};
        rewrite ^/api/crm/(.*)$ /api/$1 break;
        proxy_pass https://$upstream_host;
        proxy_ssl_server_name on;
        proxy_ssl_name $upstream_host;
        proxy_set_header Host $upstream_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    location /api/stats/ {
        set $upstream_host ${STATS_UPSTREAM};
        rewrite ^/api/stats/(.*)$ /api/$1 break;
        proxy_pass https://$upstream_host;
        proxy_ssl_server_name on;
        proxy_ssl_name $upstream_host;
        proxy_set_header Host $upstream_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    location /api/promotions/ {
        set $upstream_host ${PROMOTIONS_UPSTREAM};
        rewrite ^/api/promotions/(.*)$ /api/$1 break;
        proxy_pass https://$upstream_host;
        proxy_ssl_server_name on;
        proxy_ssl_name $upstream_host;
        proxy_set_header Host $upstream_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    location /ws {
        set $upstream_host ${CORE_UPSTREAM};
        proxy_pass https://$upstream_host;
        proxy_ssl_server_name on;
        proxy_ssl_name $upstream_host;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $upstream_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
    }

    location / {
        set $upstream_host ${CORE_UPSTREAM};
        proxy_pass https://$upstream_host;
        proxy_ssl_server_name on;
        proxy_ssl_name $upstream_host;
        proxy_set_header Host $upstream_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }
}
