# Shared local config for ALL 4 apps: copy to .env (same folder) and fill in. Never commit .env.
# Ports are NOT set here - each app has its own default (core 8080, crm 8081, stats 8082, promotions 8083).
# Need something different for one app only? Put it in that app's own .env (e.g. app-crm/.env).

# --- Shared Neon database ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/coffeeshop
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# --- JWT: one secret for every app (app-core signs, the others verify) ---
JWT_SECRET=change-this-super-secret-key-in-production-please-0123456789
JWT_EXPIRATION_MS=86400000

# --- Frontend origin allowed by CORS ---
CORS_ALLOWED_ORIGIN=http://localhost:5173
