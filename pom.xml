<?xml version="1.0" encoding="UTF-8"?>
<!--
  IDE helper only: opening coffee-shop-be in IntelliJ imports all 4 apps from this file.
  Each app is still built and deployed on its own (Render Root Directory = app-*, its own mvnw);
  nothing here is used by CI or the Dockerfiles.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.coffeeshop</groupId>
    <artifactId>coffee-shop-be-workspace</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>app-core</module>
        <module>app-crm</module>
        <module>app-stats</module>
        <module>app-promotions</module>
    </modules>
</project>
